---
import Layout from '../../layouts/Layout.astro';
import { projects, type Project } from '../../data/projects';
import { testimonials } from '../../data/testimonials';

export function getStaticPaths() {
  return projects.map((project, index) => {
    const nextProject = projects[(index + 1) % projects.length];
    const prevProject = projects[(index - 1 + projects.length) % projects.length];
    return {
      params: { slug: project.slug },
      props: { project, nextProject, prevProject }
    };
  });
}

interface Props {
  project: Project;
  nextProject: Project;
  prevProject: Project;
}

const { project, nextProject, prevProject } = Astro.props;

// Find matching testimonial if any
const matchedTestimonial = testimonials.find(t => t.projectSlug === project.slug);
---

<Layout
  title={`${project.title} — Case Study // Elena Vance Studio`}
  description={project.headline}
  activePath="/work"
>
  <article class="case-study-article">
    <!-- Top Back Navigation -->
    <header class="case-header hairline-b">
      <div class="container-minimal">
        <div class="case-nav-bar">
          <a href="/work" class="btn-pill-outline back-btn">
            <span aria-hidden="true">←</span>
            <span>Back to Projects</span>
          </a>
          <div class="case-meta-pills">
            <span class="pill-tag">{project.category}</span>
            <span class="pill-tag mono-meta mono-num">{project.year}</span>
          </div>
        </div>

        <div class="case-title-block">
          <h1 class="drasa-headline case-title">
            {project.title}<span class="title-dot">.</span>
          </h1>
          <p class="case-headline-lead">
            {project.headline}
          </p>
        </div>

        <!-- Meta Specification Bar -->
        <div class="case-specs-bar hairline-t">
          <div class="spec-col">
            <span class="mono-meta spec-lbl">CLIENT</span>
            <span class="spec-val">{project.client}</span>
          </div>
          <div class="spec-col">
            <span class="mono-meta spec-lbl">LOCATION</span>
            <span class="spec-val">{project.location}</span>
          </div>
          <div class="spec-col">
            <span class="mono-meta spec-lbl">DISCIPLINE</span>
            <span class="spec-val">{project.category}</span>
          </div>
          <div class="spec-col">
            <span class="mono-meta spec-lbl">SCALE / FORMAT</span>
            <span class="spec-val">{project.scale}</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Primary Visual Hero Plate -->
    <section class="case-hero-visual-section hairline-b">
      <div class="container-minimal">
        <div class="hero-image-frame">
          <img src={project.heroImage} alt={project.title} loading="eager" />
        </div>
        <div class="hero-caption-bar mono-meta">
          <span>PRIMARY PLATE // {project.location.toUpperCase()}</span>
          <span>DOCUMENTATION CODE: REF-{project.id}.0</span>
        </div>
      </div>
    </section>

    <!-- Project Overview (Drasa style) -->
    <section class="case-overview-section hairline-b">
      <div class="container-minimal">
        <div class="overview-grid">
          <div class="overview-left">
            <span class="mono-meta section-tag">01 // OVERVIEW</span>
            <h2 class="drasa-section-title">
              Project<br />Overview<span class="title-dot">.</span>
            </h2>
          </div>

          <div class="overview-right">
            <p class="overview-lead">
              {project.summary}
            </p>
            <div class="approach-block">
              <h3 class="approach-heading mono-meta">SUBTRACTIVE METHODOLOGY</h3>
              <p class="approach-text">{project.approach}</p>
            </div>

            <!-- Tags -->
            <div class="case-tags-strip">
              {project.tags.map(tag => (
                <span class="pill-tag">{tag}</span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Key Metrics / Specs (Drasa style) -->
    <section class="case-metrics-section hairline-b">
      <div class="container-minimal">
        <div class="metrics-header">
          <span class="mono-meta">02 // SPECIFICATIONS</span>
          <h2 class="metrics-title">Technical Matrix & Deliverables<span class="title-dot">.</span></h2>
        </div>

        <div class="metrics-grid">
          {project.specs.map(spec => (
            <div class="metric-card">
              <span class="metric-lbl mono-meta">{spec.label}</span>
              <p class="metric-val">{spec.value}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Visual Documentation Gallery Plates -->
    <section class="case-gallery-section hairline-b">
      <div class="container-minimal">
        <div class="gallery-header">
          <span class="mono-meta">03 // TACTILE CHRONICLE</span>
          <h2 class="drasa-section-title">Visual Documentation<span class="title-dot">.</span></h2>
        </div>

        <div class="gallery-grid">
          {project.gallery.map((item, idx) => (
            <figure class="gallery-card">
              <div class="gallery-img-box">
                <img src={item.url} alt={item.caption} loading="lazy" />
              </div>
              <figcaption class="gallery-caption mono-meta hairline-t">
                <span class="caption-index">PLATE {String(idx + 1).padStart(2, '0')}</span>
                <span class="caption-text">{item.caption}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- In Their Words (Client Testimonial if available) -->
    {matchedTestimonial && (
      <section class="case-quote-section hairline-b">
        <div class="container-minimal">
          <div class="case-quote-card">
            <span class="mono-meta quote-kicker">IN THEIR WORDS</span>
            <blockquote class="case-quote-text">
              “{matchedTestimonial.quote}”
            </blockquote>
            <div class="quote-signoff">
              <strong>{matchedTestimonial.author}</strong>
              <span>{matchedTestimonial.role} — {matchedTestimonial.organization}</span>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- Other Projects Section (Drasa style) -->
    <section class="other-projects-section">
      <div class="container-minimal">
        <div class="other-header-row">
          <div>
            <span class="mono-meta">04 // NEXT</span>
            <h2 class="drasa-section-title">Other Projects<span class="title-dot">.</span></h2>
          </div>
          <a href="/work" class="btn-pill">
            <span>All Projects</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="other-cards-grid">
          <a href={`/work/${prevProject.slug}`} class="other-card">
            <div class="other-media">
              <img src={prevProject.heroImage} alt={prevProject.title} loading="lazy" />
            </div>
            <div class="other-meta">
              <span class="mono-meta">{prevProject.category}</span>
              <h3 class="other-title">{prevProject.title}</h3>
              <p class="other-client">{prevProject.client}</p>
            </div>
          </a>

          <a href={`/work/${nextProject.slug}`} class="other-card">
            <div class="other-media">
              <img src={nextProject.heroImage} alt={nextProject.title} loading="lazy" />
            </div>
            <div class="other-meta">
              <span class="mono-meta">{nextProject.category}</span>
              <h3 class="other-title">{nextProject.title}</h3>
              <p class="other-client">{nextProject.client}</p>
            </div>
          </a>
        </div>
      </div>
    </section>
  </article>
</Layout>

<style>
  .case-header {
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
    padding-bottom: var(--space-10);
    background-color: var(--color-surface);
  }

  .case-nav-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .back-btn {
    padding: 8px 18px;
    font-size: 0.8125rem;
  }

  .case-meta-pills {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .case-title-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-12);
    max-width: 1100px;
  }

  .case-title {
    margin: 0;
  }

  .case-headline-lead {
    font-size: clamp(1.2rem, 1.8vw, 1.55rem);
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .case-specs-bar {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    padding-top: var(--space-8);
  }

  @media (min-width: 640px) {
    .case-specs-bar {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1040px) {
    .case-specs-bar {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .spec-col {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .spec-lbl {
    color: var(--color-text-dim);
    font-size: 0.6875rem;
  }

  .spec-val {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-primary);
  }

  /* Hero Visual */
  .case-hero-visual-section {
    padding: var(--space-12) 0;
    background-color: var(--color-surface);
  }

  .hero-image-frame {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .hero-image-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-caption-bar {
    display: flex;
    justify-content: space-between;
    padding-top: var(--space-3);
    color: var(--color-text-dim);
    font-size: 0.6875rem;
  }

  /* Overview */
  .case-overview-section {
    padding: var(--space-section) 0;
    background-color: var(--color-surface);
  }

  .overview-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
  }

  @media (min-width: 900px) {
    .overview-grid {
      grid-template-columns: 1.1fr 1.3fr;
      gap: var(--space-16);
      align-items: start;
    }
  }

  .section-tag {
    color: var(--color-text-dim);
    margin-bottom: var(--space-3);
    display: inline-block;
  }

  .overview-right {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .overview-lead {
    font-size: clamp(1.2rem, 1.8vw, 1.45rem);
    line-height: 1.55;
    font-weight: 500;
    color: var(--color-primary);
  }

  .approach-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    border-left: 2px solid var(--color-secondary);
    padding-left: var(--space-4);
  }

  .approach-heading {
    font-size: 0.6875rem;
    color: var(--color-text-dim);
  }

  .approach-text {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .case-tags-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: var(--space-2);
  }

  /* Metrics Grid */
  .case-metrics-section {
    padding: var(--space-section) 0;
    background-color: var(--color-surface);
  }

  .metrics-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .metrics-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.5vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--color-primary);
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .metrics-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1040px) {
    .metrics-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .metric-card {
    background-color: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .metric-lbl {
    color: var(--color-text-dim);
    font-size: 0.6875rem;
  }

  .metric-val {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  /* Gallery */
  .case-gallery-section {
    padding: var(--space-section) 0;
    background-color: var(--color-surface);
  }

  .gallery-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 768px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .gallery-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
  }

  .gallery-img-box {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .gallery-img-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery-caption {
    display: flex;
    justify-content: space-between;
    padding-top: var(--space-3);
    font-size: 0.6875rem;
    color: var(--color-text-dim);
  }

  /* Quote */
  .case-quote-section {
    padding: var(--space-section) 0;
    background-color: var(--color-surface);
  }

  .case-quote-card {
    background-color: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: clamp(2.5rem, 5vw, 4rem);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .quote-kicker {
    color: var(--color-secondary);
    font-weight: 600;
  }

  .case-quote-text {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.2vw, 1.85rem);
    font-weight: 500;
    line-height: 1.45;
    color: var(--color-primary);
    letter-spacing: -0.02em;
  }

  .quote-signoff {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  /* Other Projects */
  .other-projects-section {
    padding: var(--space-section) 0;
    background-color: var(--color-surface);
  }

  .other-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .other-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 768px) {
    .other-cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .other-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    text-decoration: none;
    color: inherit;
  }

  .other-media {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .other-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-expo);
  }

  .other-card:hover .other-media img {
    transform: scale(1.04);
  }

  .other-meta {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .other-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--color-primary);
    transition: color var(--transition-fast);
  }

  .other-card:hover .other-title {
    color: var(--color-secondary);
  }

  .other-client {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
</style>
