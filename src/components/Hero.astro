---
---

<section class="hero-section hairline-b" id="top">
  <div class="container-minimal hero-inner">
    <!-- Clean Subtitle Kicker (No tags, no badges) -->
    <div class="hero-header-row">
      <p class="hero-kicker">
        Elena Vance — Art Direction, Visual Systems & Editorial Atelier
      </p>
    </div>

    <!-- Monumental Typography & Circular Badge (moremedia.at reference) -->
    <div class="hero-title-area">
      <div class="hero-title-col">
        <h1 class="hero-monumental-title">
          Studio<br />
          for visual systems<br />
          & editorial craft<span class="title-dot">.</span>
        </h1>
      </div>

      <!-- Rotating Circular Scroll Badge (moremedia.at inspired) -->
      <div class="hero-badge-col">
        <a href="#featured-work" class="scrolldown-badge" aria-label="Scroll to selected work">
          <svg class="turning-svg" viewBox="0 0 120 120" width="120" height="120" aria-hidden="true">
            <defs>
              <path
                id="circlePath"
                d="M 60, 60 m -46, 0 a 46,46 0 1,1 92,0 a 46,46 0 1,1 -92,0"
              />
            </defs>
            <text class="badge-text" fill="currentColor">
              <textPath href="#circlePath" startOffset="0%">
                SELECTED COMMISSIONS · ZURICH & KYOTO ·
              </textPath>
            </text>
          </svg>
          <div class="badge-arrow-box" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <polyline points="19 12 12 19 5 12"></polyline>
            </svg>
          </div>
        </a>
      </div>
    </div>

    <!-- Editorial Statement Row (Pure text, NO buttons) -->
    <div class="hero-statement-row hairline-t">
      <div class="statement-col">
        <p class="hero-statement-text">
          We build subtractive rigor, enduring brand systems, and tactile publications for cultural institutions, design pioneers, and founders. Made calmly between Zurich and Kyoto.
        </p>
      </div>
      <div class="telemetry-col">
        <span class="telemetry-coords mono-meta">47°22′N 8°32′E // 35°00′N 135°46′E</span>
        <span class="telemetry-locations mono-meta">ZURICH · KYOTO</span>
      </div>
    </div>

    <!-- Featured Visual Showcase (moremedia.at direct work presentation) -->
    <div class="hero-featured-showcase" id="featured-work">
      <a href="/work/editions-silence" class="featured-work-card" aria-label="View Éditions Silence case study">
        <div class="featured-media-frame">
          <img
            src="https://images.unsplash.com/photo-1512820790803-83ca734da794?auto=format&fit=crop&w=2200&q=90"
            alt="Éditions Silence — Tactile Monograph for Kunsthaus Zürich"
            loading="eager"
            class="featured-img"
          />
        </div>

        <div class="featured-meta-bar">
          <div class="meta-left">
            <span class="meta-client mono-meta">Kunsthaus Zürich & Steidl Verlag</span>
            <h2 class="meta-title">Éditions Silence — Monograph & Exhibition Scenography</h2>
          </div>
          <div class="meta-action" aria-hidden="true">
            <span class="action-cross">+</span>
          </div>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: clamp(2.75rem, 5vw, 4.75rem);
    padding-bottom: clamp(4rem, 8vw, 7rem);
    background-color: var(--color-surface);
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  /* Kicker Header */
  .hero-header-row {
    display: flex;
    align-items: center;
  }

  .hero-kicker {
    font-family: var(--font-display);
    font-size: clamp(0.85rem, 1.1vw, 1.05rem);
    font-weight: 500;
    color: var(--color-text-muted);
    letter-spacing: -0.01em;
    margin: 0;
  }

  /* Monumental Title Area with Rotating Badge */
  .hero-title-area {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: end;
  }

  @media (min-width: 900px) {
    .hero-title-area {
      grid-template-columns: 1fr auto;
      gap: var(--space-12);
    }
  }

  .hero-title-col {
    display: flex;
    flex-direction: column;
  }

  .hero-monumental-title {
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 8.4vw, 7.8rem);
    font-weight: 600;
    line-height: 0.94;
    letter-spacing: -0.04em;
    color: var(--color-primary);
    margin: 0;
  }

  /* Rotating Circular Badge */
  .hero-badge-col {
    display: flex;
    align-items: center;
  }

  .scrolldown-badge {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 120px;
    height: 120px;
    color: var(--color-primary);
    text-decoration: none;
    cursor: pointer;
    transition: transform var(--transition-normal);
    user-select: none;
  }

  .scrolldown-badge:hover {
    transform: scale(1.06);
  }

  .turning-svg {
    width: 100%;
    height: 100%;
    animation: spinBadge 20s linear infinite;
    transform-origin: center;
  }

  .scrolldown-badge:hover .turning-svg {
    animation-duration: 9s;
  }

  @keyframes spinBadge {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  .badge-text {
    font-family: var(--font-mono);
    font-size: 8.5px;
    letter-spacing: 2.2px;
    text-transform: uppercase;
    font-weight: 500;
  }

  .badge-arrow-box {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    transition: transform var(--transition-fast), color var(--transition-fast);
  }

  .scrolldown-badge:hover .badge-arrow-box {
    transform: translate(-50%, -38%);
    color: var(--color-secondary);
  }

  /* Editorial Statement Row */
  .hero-statement-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    padding-top: var(--space-8);
  }

  @media (min-width: 860px) {
    .hero-statement-row {
      grid-template-columns: 1.6fr 1fr;
      align-items: end;
      justify-content: space-between;
      gap: var(--space-12);
    }
  }

  .hero-statement-text {
    font-size: clamp(1.15rem, 1.7vw, 1.45rem);
    line-height: 1.5;
    font-weight: 400;
    color: var(--color-text-muted);
    max-width: 780px;
    margin: 0;
  }

  .telemetry-col {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-align: left;
  }

  @media (min-width: 860px) {
    .telemetry-col {
      text-align: right;
    }
  }

  .telemetry-coords {
    color: var(--color-text-dim);
    font-size: 0.6875rem;
  }

  .telemetry-locations {
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.75rem;
  }

  /* Featured Visual Showcase */
  .hero-featured-showcase {
    width: 100%;
    margin-top: var(--space-4);
  }

  .featured-work-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    text-decoration: none;
    color: inherit;
  }

  .featured-media-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  @media (min-width: 1100px) {
    .featured-media-frame {
      aspect-ratio: 21 / 10;
    }
  }

  .featured-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease-expo);
  }

  .featured-work-card:hover .featured-img {
    transform: scale(1.035);
  }

  .featured-meta-bar {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    padding-top: var(--space-2);
  }

  .meta-left {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .meta-client {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--color-text-dim);
  }

  .meta-title {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.9vw, 1.65rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-primary);
    margin: 0;
    transition: color var(--transition-fast);
  }

  .featured-work-card:hover .meta-title {
    color: var(--color-secondary);
  }

  .meta-action {
    flex-shrink: 0;
  }

  .action-cross {
    font-family: var(--font-display);
    font-size: 1.85rem;
    font-weight: 300;
    line-height: 1;
    color: var(--color-primary);
    display: inline-block;
    transition: transform var(--transition-fast), color var(--transition-fast);
  }

  .featured-work-card:hover .action-cross {
    transform: rotate(45deg);
    color: var(--color-secondary);
  }

  /* Responsive Adjustments */
  @media (max-width: 640px) {
    .scrolldown-badge {
      width: 95px;
      height: 95px;
    }

    .scrolldown-badge svg {
      width: 95px;
      height: 95px;
    }

    .badge-text {
      font-size: 8px;
    }

    .badge-arrow-box svg {
      width: 15px;
      height: 15px;
    }

    .featured-media-frame {
      aspect-ratio: 16 / 10;
    }
  }
</style>
