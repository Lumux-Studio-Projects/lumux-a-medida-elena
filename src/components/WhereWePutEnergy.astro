---
---

<section class="energy-labs-section hairline-b" id="energy">
  <div class="container-minimal">
    <div class="section-top-row">
      <span class="mono-meta section-label">03 // DISCIPLINES</span>
      <h2 class="drasa-section-title">
        Where we<br />put our energy<span class="title-dot">.</span>
      </h2>
    </div>

    <!-- Labs Grid -->
    <div class="labs-grid">
      <!-- Lab 1: Visual Systems -->
      <div class="lab-card">
        <div class="lab-card-header">
          <div class="lab-code-pill mono-meta">LAB 01</div>
          <span class="lab-status mono-meta">● IN ACTIVE RESEARCH</span>
        </div>

        <div class="lab-card-body">
          <h3 class="lab-title">Visual Systems Lab</h3>
          <p class="lab-description">
            Building coherent, enduring graphic architecture for ambitious brands and digital platforms. We reject ephemeral trends in favor of mathematical baseline grids, custom typography, and sub-millisecond digital rigor.
          </p>

          <div class="lab-capabilities">
            <span class="cap-item">Brand Identity Systems</span>
            <span class="cap-sep">·</span>
            <span class="cap-item">Generative Typography</span>
            <span class="cap-sep">·</span>
            <span class="cap-item">Design Systems</span>
            <span class="cap-sep">·</span>
            <span class="cap-item">Digital Platforms</span>
            <span class="cap-sep">·</span>
            <span class="cap-item">Creative Direction</span>
          </div>
        </div>

        <div class="lab-card-footer hairline-t">
          <span class="lab-output-label mono-meta">PRIMARY DELIVERABLE:</span>
          <span class="lab-output-value">Living Brand Code & Type Systems</span>
        </div>
      </div>

      <!-- Lab 2: Tactile & Spatial -->
      <div class="lab-card">
        <div class="lab-card-header">
          <div class="lab-code-pill mono-meta">LAB 02</div>
          <span class="lab-status mono-meta">● IN ATELIER PRODUCTION</span>
        </div>

        <div class="lab-card-body">
          <h3 class="lab-title">Tactile & Spatial Lab</h3>
          <p class="lab-description">
            Investigating physical friction, paper materiality, and exhibition silence. We craft limited-edition monographs, museum publications, and architectural scenography that respect human contemplation.
          </p>

          <div class="lab-capabilities">
            <span class="cap-item">Editorial Monographs</span>
            <span class="cap-sep">·</span>
            <span class="cap-item">Lay-Flat Bookbinding</span>
            <span class="cap-sep">·</span>
            <span class="cap-item">Spatial Scenography</span>
            <span class="cap-sep">·</span>
            <span class="cap-item">Paper & Material R&D</span>
            <span class="cap-sep">·</span>
            <span class="cap-item">Tactile Packaging</span>
          </div>
        </div>

        <div class="lab-card-footer hairline-t">
          <span class="lab-output-label mono-meta">PRIMARY DELIVERABLE:</span>
          <span class="lab-output-value">Permanent Physical Objects & Spaces</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .energy-labs-section {
    padding: var(--space-section) 0;
    background-color: var(--color-surface);
  }

  .section-top-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }

  .section-label {
    color: var(--color-text-dim);
  }

  /* Labs Grid */
  .labs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 900px) {
    .labs-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-8);
    }
  }

  .lab-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background-color: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: clamp(1.8rem, 3.5vw, 2.75rem);
    transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .lab-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
  }

  .lab-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-8);
  }

  .lab-code-pill {
    padding: 4px 10px;
    background-color: var(--color-surface-subtle);
    border-radius: var(--radius-pill);
    color: var(--color-primary);
    font-weight: 600;
  }

  .lab-status {
    color: var(--color-secondary);
    font-size: 0.6875rem;
  }

  .lab-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .lab-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.4vw, 2.1rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--color-primary);
  }

  .lab-description {
    font-size: clamp(0.95rem, 1.2vw, 1.05rem);
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .lab-capabilities {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: var(--space-4);
    padding: var(--space-4);
    background-color: var(--color-surface-subtle);
    border-radius: var(--radius-xs);
  }

  .cap-item {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-primary);
  }

  .cap-sep {
    color: var(--color-text-dim);
  }

  .lab-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-4);
    font-size: 0.75rem;
  }

  .lab-output-label {
    color: var(--color-text-dim);
  }

  .lab-output-value {
    color: var(--color-primary);
    font-weight: 500;
  }
</style>
