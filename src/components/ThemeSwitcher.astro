---
import themeData from '../data/theme.json';
---

<div class="theme-switcher-container" id="themeSwitcherRoot">
  <!-- Botón disparador flotante -->
  <button 
    type="button" 
    class="theme-trigger-btn" 
    id="themeTriggerBtn"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="themeModal"
    title="Cambiar paleta cromática del sitio"
  >
    <span class="palette-icon" aria-hidden="true">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/>
        <circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/>
        <circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/>
        <circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/>
        <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/>
      </svg>
    </span>
    <span class="trigger-label mono-meta">PALETA</span>
    <span class="current-theme-indicator mono-meta" id="currentThemeName">Alabastro</span>
  </button>

  <!-- Modal / Popover flotante -->
  <div 
    class="theme-modal" 
    id="themeModal" 
    role="dialog" 
    aria-label="Selector de temas cromáticos"
    hidden
  >
    <div class="theme-modal-header">
      <div>
        <h4 class="theme-modal-title">Atmósferas de Diseño</h4>
        <p class="theme-modal-desc">4 universos cromáticos de alta dirección de arte.</p>
      </div>
      <button type="button" class="theme-close-btn" id="themeCloseBtn" aria-label="Cerrar selector">✕</button>
    </div>

    <div class="theme-options-list">
      {themeData.themes.map((t) => (
        <button 
          type="button" 
          class="theme-option-btn" 
          data-theme-id={t.id}
          data-theme-label={t.name.split(' ')[0]}
        >
          <div class="theme-swatch-preview">
            <span class="swatch-circle" style={`background-color: ${t.colors.bgPrimary}; border: 1px solid ${t.colors.border};`}></span>
            <span class="swatch-circle" style={`background-color: ${t.colors.accent};`}></span>
            <span class="swatch-circle" style={`background-color: ${t.colors.textPrimary};`}></span>
          </div>
          <div class="theme-option-info">
            <span class="theme-option-name">{t.name}</span>
            <span class="theme-option-sub">{t.subtitle}</span>
          </div>
          <span class="theme-check-icon" aria-hidden="true">✓</span>
        </button>
      ))}
    </div>

    <div class="theme-modal-footer">
      <small class="mono-meta">DIRECCIÓN DE ARTE // LUMUX STUDIO</small>
    </div>
  </div>
</div>

<style>
  .theme-switcher-container {
    position: fixed;
    bottom: 1.75rem;
    right: 1.75rem;
    z-index: 999;
    font-family: var(--font-sans);
  }

  .theme-trigger-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: var(--color-surface-card);
    color: var(--color-primary);
    border: 1px solid var(--color-border);
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    box-shadow: 0 4px 20px rgba(12, 12, 11, 0.08);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .theme-trigger-btn:hover {
    transform: translateY(-2px);
    border-color: var(--color-primary);
    box-shadow: 0 8px 24px rgba(12, 12, 11, 0.14);
  }

  .palette-icon {
    display: inline-flex;
    align-items: center;
    color: var(--color-secondary);
  }

  .trigger-label {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .current-theme-indicator {
    background-color: var(--color-surface-subtle);
    color: var(--color-primary);
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    font-size: 0.6875rem;
    font-weight: 600;
  }

  .theme-modal {
    position: absolute;
    bottom: calc(100% + 0.75rem);
    right: 0;
    width: 320px;
    background-color: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    box-shadow: 0 16px 40px rgba(12, 12, 11, 0.16);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    animation: fadeInModal 0.22s var(--ease-expo);
  }

  .theme-modal[hidden] {
    display: none;
  }

  @keyframes fadeInModal {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .theme-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .theme-modal-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-primary);
    letter-spacing: -0.01em;
  }

  .theme-modal-desc {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-top: 2px;
  }

  .theme-close-btn {
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    font-size: 1rem;
    cursor: pointer;
    padding: 2px 6px;
    line-height: 1;
    border-radius: var(--radius-xs);
  }

  .theme-close-btn:hover {
    color: var(--color-primary);
  }

  .theme-options-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .theme-option-btn {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 10px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    cursor: pointer;
    text-align: left;
    transition: all var(--transition-fast);
  }

  .theme-option-btn:hover {
    border-color: var(--color-primary);
    transform: translateX(2px);
  }

  .theme-option-btn.active {
    border-color: var(--color-primary);
    background-color: var(--color-surface-subtle);
  }

  .theme-swatch-preview {
    display: flex;
    gap: 4px;
    align-items: center;
    flex-shrink: 0;
  }

  .swatch-circle {
    width: 14px;
    height: 14px;
    border-radius: 50%;
  }

  .theme-option-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .theme-option-name {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  .theme-option-sub {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    line-height: 1.3;
  }

  .theme-check-icon {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-secondary);
    opacity: 0;
  }

  .theme-option-btn.active .theme-check-icon {
    opacity: 1;
  }

  .theme-modal-footer {
    border-top: 1px solid var(--color-border);
    padding-top: 0.65rem;
  }

  .theme-modal-footer small {
    font-size: 0.65rem;
    color: var(--color-text-dim);
    display: block;
  }

  @media (max-width: 480px) {
    .theme-switcher-container {
      bottom: 1rem;
      right: 1rem;
    }

    .theme-trigger-btn {
      padding: 6px 10px;
      gap: 6px;
    }

    .trigger-label {
      display: none;
    }

    .theme-modal {
      width: min(calc(100vw - 2rem), 320px);
      right: 0;
      padding: 1rem;
    }
  }
</style>

<script is:inline>
  (() => {
    function initThemeSwitcher() {
      const trigger = document.getElementById('themeTriggerBtn');
      const modal = document.getElementById('themeModal');
      const closeBtn = document.getElementById('themeCloseBtn');
      const currentNameEl = document.getElementById('currentThemeName');
      const optionBtns = document.querySelectorAll('.theme-option-btn');

      const validThemes = ['alabastro', 'klein-studio', 'nordic-sage', 'obsidian-noir'];
      let currentTheme = localStorage.getItem('vance_theme');
      if (!currentTheme || !validThemes.includes(currentTheme)) {
        currentTheme = 'alabastro';
        localStorage.setItem('vance_theme', 'alabastro');
      }
      applyTheme(currentTheme);

      function applyTheme(themeId) {
        document.documentElement.setAttribute('data-theme', themeId);
        localStorage.setItem('vance_theme', themeId);

        optionBtns.forEach(btn => {
          const id = btn.getAttribute('data-theme-id');
          const isActive = id === themeId;
          btn.classList.toggle('active', isActive);
          if (isActive && currentNameEl) {
            currentNameEl.textContent = btn.getAttribute('data-theme-label') || themeId;
          }
        });
      }

      function openModal() {
        modal.hidden = false;
        trigger.setAttribute('aria-expanded', 'true');
      }

      function closeModal() {
        modal.hidden = true;
        trigger.setAttribute('aria-expanded', 'false');
      }

      trigger.onclick = () => {
        if (modal.hidden) openModal();
        else closeModal();
      };

      if (closeBtn) closeBtn.onclick = closeModal;

      optionBtns.forEach(btn => {
        btn.onclick = () => {
          const id = btn.getAttribute('data-theme-id');
          if (id) {
            applyTheme(id);
            setTimeout(closeModal, 160);
          }
        };
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modal.hidden) closeModal();
      });

      document.addEventListener('click', (e) => {
        if (!modal.hidden && !modal.contains(e.target) && !trigger.contains(e.target)) {
          closeModal();
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initThemeSwitcher);
    } else {
      initThemeSwitcher();
    }

    document.addEventListener('astro:page-load', initThemeSwitcher);
  })();
</script>
