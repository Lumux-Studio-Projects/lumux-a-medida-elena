---
---

<section class="founder-section hairline-b" id="founder">
  <div class="container-minimal">
    <div class="founder-layout">
      <!-- Left: Portrait Frame -->
      <div class="founder-media-col">
        <div class="founder-portrait-frame">
          <img
            src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=1200&q=85"
            alt="Elena Vance — Principal & Creative Director"
            loading="lazy"
          />
        </div>
        <div class="founder-meta-caption">
          <span class="mono-meta">PORTRAIT // ZURICH ATELIER</span>
          <span class="mono-meta status-dot">● PRINCIPAL</span>
        </div>
      </div>

      <!-- Right: Story & Bio -->
      <div class="founder-text-col">
        <span class="mono-meta section-label">02 // LEADERSHIP</span>
        <h2 class="drasa-section-title">
          Elena Vance<span class="title-dot">.</span>
        </h2>

        <p class="founder-bio-main">
          A Zurich-born and Kyoto-trained art director, visual systems architect, and bookmaker who uses Swiss grid rationalism, material research, and design to help people and organisations see themselves clearly and think more bravely.
        </p>

        <p class="founder-bio-sub">
          "I think of myself as the analyst and the artist working as one instrument. I’ve never had to choose between mathematical rigor and tactile play, because for me the rigor is the play. Give me complexity to make pure, and you’ll get our best work."
        </p>

        <!-- Credentials Badges -->
        <div class="credentials-pills">
          <span class="pill-tag">ZHdK ZÜRICH (VISUAL SYSTEMS)</span>
          <span class="pill-tag">ECHIZEN WASHI FELLOW</span>
          <span class="pill-tag">STEIDL MONOGRAPH AWARD</span>
          <span class="pill-tag">HARVARD EXEC ED</span>
        </div>

        <div class="founder-action">
          <a href="/philosophy#founder" class="btn-pill">
            <span>Read the Full Story</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .founder-section {
    padding: var(--space-section) 0;
    background-color: var(--color-surface);
  }

  .founder-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
  }

  @media (min-width: 900px) {
    .founder-layout {
      grid-template-columns: 1fr 1.25fr;
      gap: var(--space-16);
      align-items: center;
    }
  }

  /* Media Frame */
  .founder-media-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .founder-portrait-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .founder-portrait-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(15%) contrast(102%);
    transition: transform 0.8s var(--ease-expo), filter 0.6s ease;
  }

  .founder-portrait-frame:hover img {
    transform: scale(1.03);
    filter: grayscale(0%) contrast(100%);
  }

  .founder-meta-caption {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--color-text-dim);
  }

  .status-dot {
    color: var(--color-secondary);
  }

  /* Text Column */
  .founder-text-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .section-label {
    color: var(--color-text-dim);
  }

  .founder-bio-main {
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    line-height: 1.45;
    font-weight: 500;
    color: var(--color-primary);
    letter-spacing: -0.02em;
  }

  .founder-bio-sub {
    font-size: clamp(0.95rem, 1.25vw, 1.1rem);
    line-height: 1.65;
    color: var(--color-text-muted);
    font-style: italic;
    border-left: 2px solid var(--color-secondary);
    padding-left: var(--space-4);
  }

  .credentials-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .founder-action {
    padding-top: var(--space-2);
  }
</style>
