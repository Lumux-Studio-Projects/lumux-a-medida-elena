---
---

<footer class="drasa-footer hairline-t" id="colophon">
  <div class="container-minimal">
    <!-- Big Typographic Drasa Call-to-Action -->
    <div class="footer-cta-block">
      <span class="mono-meta cta-kicker">INITIATE A COMMISSION // Q4 2026</span>
      <h2 class="footer-cta-title">
        Let’s build<br />something brave<span class="title-dot">.</span>
      </h2>
      <p class="footer-cta-lead">
        An art direction and visual systems atelier for teams ready to do the braver, more enduring version of the work. Made calmly, with senior practitioners.
      </p>

      <!-- Direct Email Interaction -->
      <div class="footer-action-strip">
        <a href="mailto:elena@vancestudio.ch" class="direct-email-link" id="footer-email-link">
          elena@vancestudio.ch
        </a>
        <button class="btn-pill-outline copy-email-btn" id="footer-copy-btn" aria-label="Copy studio email address">
          <span id="footer-copy-text">Copy Email</span>
        </button>
        <a href="/contact" class="btn-pill-accent">
          <span>Start Brave</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <!-- Navigation & Directory Grid -->
    <div class="footer-directory-grid hairline-t">
      <!-- Nav Links -->
      <div class="dir-col">
        <span class="dir-title mono-meta">NAVIGATION</span>
        <ul class="dir-list">
          <li><a href="/work" class="dir-link">Projects</a></li>
          <li><a href="/philosophy" class="dir-link">Philosophy</a></li>
          <li><a href="/collective" class="dir-link">The Collective</a></li>
          <li><a href="/contact" class="dir-link">Start Brave</a></li>
        </ul>
      </div>

      <!-- Ateliers -->
      <div class="dir-col">
        <span class="dir-title mono-meta">ATELIER PRESENCE</span>
        <div class="dir-location-item">
          <strong>Zürich Atelier</strong>
          <span class="location-detail">Neugasse 29, 8005 Zürich, Switzerland</span>
        </div>
        <div class="dir-location-item">
          <strong>Kyoto Studio</strong>
          <span class="location-detail">Gion-machi, Higashiyama-ku, Kyoto, Japan</span>
        </div>
      </div>

      <!-- Collective & Stack -->
      <div class="dir-col">
        <span class="dir-title mono-meta">STUDIO TELEMETRY</span>
        <p class="dir-desc">
          Independent creative direction atelier operating on Swiss grid rationalism and Japanese material craft.
        </p>
        <a href="https://lumuxstudio.com/es" target="_blank" rel="noopener noreferrer" class="lumux-pill mono-meta">
          <span class="status-dot" aria-hidden="true">●</span>
          <span>WEBSITE BY LUMUX STUDIO ↗</span>
        </a>
      </div>

      <!-- Connect & Back to top -->
      <div class="dir-col dir-end">
        <span class="dir-title mono-meta">CONNECT</span>
        <ul class="dir-list">
          <li>
            <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="dir-link">
              <span>LinkedIn</span>
              <span aria-hidden="true">↗</span>
            </a>
          </li>
          <li>
            <button class="back-to-top-btn" id="footer-back-to-top" aria-label="Return to top of page">
              <span>Return to Top</span>
              <span aria-hidden="true">↑</span>
            </button>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Colophon Bar -->
    <div class="footer-bottom-bar hairline-t">
      <div class="bottom-left mono-meta">
        © 2026 ATELIER ELENA VANCE. ALL RIGHTS RESERVED.
      </div>
      <div class="bottom-right mono-meta">
        <span>SWISS TYPOGRAPHIC RIGOR</span>
        <span class="dot-sep">·</span>
        <span>RADICAL REDUCTION</span>
      </div>
    </div>
  </div>
</footer>

<script>
  import { getLenis } from '../scripts/motion';

  // Back to top with Lenis
  const backToTopBtn = document.getElementById('footer-back-to-top');
  if (backToTopBtn) {
    backToTopBtn.addEventListener('click', (e) => {
      e.preventDefault();
      const lenis = getLenis();
      if (lenis) {
        lenis.scrollTo(0, { duration: 1.2 });
      } else {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });
  }

  // Copy email with feedback
  const copyBtn = document.getElementById('footer-copy-btn');
  const copyText = document.getElementById('footer-copy-text');
  if (copyBtn && copyText) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('elena@vancestudio.ch');
        copyText.textContent = 'Copied to Clipboard!';
        setTimeout(() => {
          copyText.textContent = 'Copy Email';
        }, 2400);
      } catch (err) {
        copyText.textContent = 'elena@vancestudio.ch';
      }
    });
  }
</script>

<style>
  .drasa-footer {
    padding-top: clamp(4.5rem, 9vw, 8rem);
    padding-bottom: var(--space-8);
    background-color: var(--color-surface);
  }

  /* Big CTA Block */
  .footer-cta-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    margin-bottom: clamp(4rem, 8vw, 7rem);
    max-width: 1100px;
  }

  .cta-kicker {
    color: var(--color-text-dim);
    letter-spacing: 0.08em;
  }

  .footer-cta-title {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 7.5vw, 6.2rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.02;
    color: var(--color-primary);
  }

  .footer-cta-lead {
    font-size: clamp(1.15rem, 1.8vw, 1.5rem);
    line-height: 1.5;
    color: var(--color-text-muted);
    max-width: 820px;
  }

  .footer-action-strip {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    padding-top: var(--space-4);
  }

  .direct-email-link {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 6px;
    transition: color var(--transition-fast);
  }

  .direct-email-link:hover {
    color: var(--color-secondary);
  }

  /* Directory Grid */
  .footer-directory-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    padding: var(--space-12) 0;
  }

  @media (min-width: 640px) {
    .footer-directory-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1040px) {
    .footer-directory-grid {
      grid-template-columns: 1.2fr 1.6fr 1.6fr 1fr;
      align-items: start;
    }
  }

  .dir-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .dir-title {
    color: var(--color-text-dim);
    font-size: 0.6875rem;
    margin-bottom: 2px;
  }

  .dir-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .dir-link {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-primary);
    transition: color var(--transition-fast);
  }

  .dir-link:hover {
    color: var(--color-secondary);
  }

  .dir-location-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 0.875rem;
  }

  .dir-location-item strong {
    color: var(--color-primary);
    font-family: var(--font-display);
  }

  .location-detail {
    color: var(--color-text-muted);
    font-size: 0.8125rem;
  }

  .dir-desc {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .lumux-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    background-color: var(--color-surface-subtle);
    border-radius: var(--radius-pill);
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    width: fit-content;
  }

  .lumux-pill:hover {
    color: var(--color-text-primary);
  }

  .lumux-pill:focus-visible {
    outline: 2px solid var(--color-secondary);
    outline-offset: 4px;
  }

  .status-dot {
    color: var(--color-secondary);
  }

  .back-to-top-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-display);
    font-size: 0.875rem;
    color: var(--color-primary);
    padding: 6px 14px;
    background-color: var(--color-surface-subtle);
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    transition: all var(--transition-fast);
    cursor: pointer;
  }

  .back-to-top-btn:hover {
    border-color: var(--color-primary);
    background-color: var(--color-surface-card);
  }

  /* Bottom Bar */
  .footer-bottom-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding-top: var(--space-8);
    font-size: 0.6875rem;
    color: var(--color-text-dim);
  }

  .dot-sep {
    margin: 0 4px;
    opacity: 0.4;
  }
</style>
